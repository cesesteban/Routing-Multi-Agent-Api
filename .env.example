# LLM Configuration
# Options: openai, groq, gemini, lm_studio
LLM_PROVIDER=lm_studio

# Model Selection (defaults to provider specific)
MODEL_NAME=local-model

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here

# Gemini Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Vertex AI / Google Calendar Configuration
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/credentials.json

# Langfuse (Observability & Evaluation)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# LM Studio Configuration
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# ── Agent Tools Configuration ────────────────────────────────────────────────

# Tools Mode: set to "false" to make real API calls
DRY_RUN=true

# Jira (REST API v3)
JIRA_BASE_URL=https://tu-empresa.atlassian.net
JIRA_EMAIL=bot@empresa.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=SUPPORT
JIRA_ASSIGNEE_TECH=tech-team
JIRA_ASSIGNEE_RECLAMOS=support-team
JIRA_ASSIGNEE_RRHH=hr-team
JIRA_ASSIGNEE_FINANZAS=finance-team
JIRA_ASSIGNEE_GENERAL=support-team

# Slack (Incoming Webhooks - one per department channel)
SLACK_WEBHOOK_RRHH=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_TECNOLOGIA=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_FINANZAS=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_RECLAMOS=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_GENERAL=https://hooks.slack.com/services/xxx/yyy/zzz

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bot@empresa.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=soporte@empresa.com

# Google Calendar
CALENDAR_ID=primary
