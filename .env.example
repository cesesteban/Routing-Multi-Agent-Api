# =============================================================================
#  MULTI-AGENT SYSTEM — CONFIGURACIÓN DE ENTORNO
#  Copia este archivo a .env y completa los valores reales.
# =============================================================================

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Opciones: openai | groq | gemini | vertexai | lm_studio
LLM_PROVIDER=lm_studio

# ── Modelos de LLM ────────────────────────────────────────────────────────────
# MODEL_NANO    → Router/Clasificador (modelo rápido y ligero)
# MODEL_POWERFUL → Especialistas, Crítico y Evaluador (modelo más capaz)
#
# Ejemplos por provider:
#   lm_studio : gemma-3-1b           / gemma-3-4b
#   groq      : llama-3.1-8b-instant / llama-3.3-70b-versatile
#   gemini    : gemini-2.0-flash      / gemini-2.0-pro
#   vertexai  : gemini-2.0-flash      / gemini-2.0-pro
#   openai    : gpt-4o-mini           / gpt-4o
MODEL_NANO=gemma-3-1b
MODEL_POWERFUL=gemma-3-4b

# ── Embeddings Provider (independiente del LLM) ───────────────────────────────
# Si no se define, hereda el mismo valor que LLM_PROVIDER.
# IMPORTANTE: Groq NO soporta embeddings → usar otro provider.
#
# Opciones: openai | gemini | vertexai | lm_studio
EMBEDDINGS_PROVIDER=lm_studio

# Modelo de embeddings a usar (si no se define, se usa el default del provider):
#   openai   : text-embedding-3-small | text-embedding-3-large
#   gemini   : models/embedding-001   | models/text-embedding-004
#   vertexai : text-multilingual-embedding-002 | text-embedding-004
#   lm_studio: (el que tengas cargado en LM Studio)
#EMBEDDING_MODEL_NAME=text-multilingual-embedding-002

# URL del endpoint de embeddings (solo para lm_studio, si es diferente al LLM)
#EMBEDDINGS_BASE_URL=http://localhost:1234/v1

# ── API Keys ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
GOOGLE_API_KEY=AIza...    # Gemini via API Key (no Vertex)

# ── Vertex AI / Google Cloud ───────────────────────────────────────────────────
# Requiere: gcloud auth application-default login  ó  archivo de credenciales
GOOGLE_CLOUD_PROJECT=my-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
#GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── LM Studio (local) ─────────────────────────────────────────────────────────
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# URLs separadas si corres nano y powerful en puertos distintos:
#LM_STUDIO_NANO_URL=http://localhost:1234/v1
#LM_STUDIO_POWERFUL_URL=http://localhost:1235/v1

# ── Langfuse (Observability & Evaluation) ─────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Agent Tools ───────────────────────────────────────────────────────────────
# DRY_RUN=true  → simula las llamadas a Jira/Slack/Email (sin efectos reales)
DRY_RUN=true

# Jira (REST API v3)
JIRA_BASE_URL=https://tu-empresa.atlassian.net
JIRA_EMAIL=bot@empresa.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=SUPPORT
JIRA_ASSIGNEE_TECH=tech-team
JIRA_ASSIGNEE_RECLAMOS=support-team
JIRA_ASSIGNEE_RRHH=hr-team
JIRA_ASSIGNEE_FINANZAS=finance-team
JIRA_ASSIGNEE_GENERAL=support-team

# Slack (Incoming Webhooks — uno por canal de departamento)
SLACK_WEBHOOK_RRHH=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_TECNOLOGIA=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_FINANZAS=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_RECLAMOS=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_GENERAL=https://hooks.slack.com/services/xxx/yyy/zzz

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bot@empresa.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=soporte@empresa.com

# Google Calendar
CALENDAR_ID=primary

