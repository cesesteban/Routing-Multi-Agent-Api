{
  "openapi": "3.1.0",
  "info": {
    "title": "Multi-Agent Routing System API",
    "description": "Sistema experto de orquestación de agentes con RAG y Auditoría",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/api/v1/query": {
      "post": {
        "tags": [
          "Agents"
        ],
        "summary": "Process New Query",
        "description": "Inicia el flujo multi-agente para procesar una consulta.",
        "operationId": "process_new_query_api_v1_api_v1_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailedQueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/api/v1/history": {
      "get": {
        "tags": [
          "Agents"
        ],
        "summary": "Get Query History",
        "description": "Obtiene el historial de consultas persistido.",
        "operationId": "get_query_history_api_v1_api_v1_history_get",
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QueryResponse"
                  },
                  "title": "Response Get Query History Api V1 Api V1 History Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/api/v1/query/{query_id}": {
      "get": {
        "tags": [
          "Agents"
        ],
        "summary": "Get Query Detail",
        "description": "Obtiene los detalles completos de una consulta específica.",
        "operationId": "get_query_detail_api_v1_api_v1_query__query_id__get",
